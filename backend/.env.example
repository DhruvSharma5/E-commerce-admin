PORT=5000
NODE_ENV=development
MONGO_URI=mongodb://127.0.0.1:27017/auth_product_db
ACCESS_TOKEN_SECRET=change_me_access_secret_long_random_string
REFRESH_TOKEN_SECRET=change_me_refresh_secret_another_long_random_string
ACCESS_TOKEN_EXPIRES=15m
REFRESH_TOKEN_EXPIRES=7d
# Only needed if frontend is hosted on a different origin than the API
CLIENT_URL=https://e-commerce-admin-ten-ruby.vercel.app
# Use 'none' for a separate frontend/API origin in production; 'lax' is convenient locally.
COOKIE_SAME_SITE=lax
